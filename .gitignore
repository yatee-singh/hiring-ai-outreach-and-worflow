```gitignore
# =========================
# Python / FastAPI
# =========================

Backend/venv/
Backend/.venv/

# Python cache
__pycache__/
*.py[cod]

# Environment variables
.env
.env.*
!.env.example


# =========================
# Node / React / Vite
# =========================

Frontend/node_modules/
Frontend/dist/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# =========================
# IDE / OS
# =========================

.vscode/
.idea/
.DS_Store
```
